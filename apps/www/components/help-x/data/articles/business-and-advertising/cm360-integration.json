itter metric"]}],"header":true}],[{"blocks":[{"type":"p","runs":[">x<: Video 50% in view for 2 seconds"]}]},{"blocks":[{"type":"p","runs":["Video views"]}]}]]},{"type":"table","rows":[[{"blocks":[{"type":"p","runs":["DoubleClick metric"]}],"header":true},{"blocks":[{"type":"p","runs":["Twitter metric"]}],"header":true}],[{"blocks":[{"type":"p","runs":[">x<: Video 100% in view for 3 seconds"]}]},{"blocks":[{"type":"p","runs":["3s/100% video views"]}]}]]},{"type":"table","rows":[[{"blocks":[{"type":"p","runs":["DoubleClick metric"]}],"header":true},{"blocks":[{"type":"p","runs":["Twitter metric"]}],"header":true}],[{"blocks":[{"type":"p","runs":[">x< creative ID"]}]},{"blocks":[{"type":"p","runs":["Status ID"]}]}]]},{"type":"table","rows":[[{"blocks":[{"type":"p","runs":["DoubleClick metric"]}],"header":true},{"blocks":[{"type":"p","runs":["Twitter metric"]}],"header":true}],[{"blocks":[{"type":"p","runs":[">x< campaign ID"]}]},{"blocks":[{"type":"p","runs":["Campaign ID"]}]}]]},{"type":"table","rows":[[{"blocks":[{"type":"p","runs":["DoubleClick metric"]}],"header":true},{"blocks":[{"type":"p","runs":["Twitter metric"]}],"header":true}],[{"blocks":[{"type":"p","runs":[">x< creative ID"]}]},{"blocks":[{"type":"p","runs":["Status ID"]}]}]]},{"type":"heading","level":2,"runs":["Frequently asked questions"],"id":"frequently-asked-questions"},{"type":"accordion","items":[{"id":"help-m012429-item-0","q":["Does the Click Tag report on impressions or additional metrics?"],"blocks":[{"type":"p","runs":["No, the Click Tag only supports link clicks."]}]},{"id":"help-m012429-item-1","q":["Why doesn't the Campaign Manager 360 (CM360) data match the >x< data?"],"blocks":[{"type":"p","runs":["It’s expected that Campaign Manager 360 (CM360) and >x< data do not match perfectly. Each system uses a different data pipeline which results in differences in data. If you see larger than 15% differences, please reach out to your >x< Account Manager."]}]},{"id":"help-m012429-item-2","q":["Can I add, or piggyback, additional tags to my Campaign Manager 360 (CM360) tracking tag?"],"blocks":[{"type":"p","runs":["No, other tags should not be included when using the CM360 click tag. This includes other 3P tags or inserting tags into the post URL."]}]},{"id":"help-m012429-item-3","q":["Can I use Campaign Manager 360 (CM360) with all campaign objectives?"],"blocks":[{"type":"p","runs":["Campaign Manager 360 (CM360) Impression tags will work for all campaign objectives. Campaign Manager 360 (CM360 Click tags will work for Website traffic, Video views, and Pre-roll views."]}]},{"id":"help-m012429-item-4","q":["Why aren't my conversions matching between Campaign Manager 360 (CM360) and the >x< campaign dashboard?"],"blocks":[{"type":"p","runs":["It’s expected that in some cases conversions will not match between Campaign Manager 360 (CM360) and >x<. If you're tracking other channels in Campaign Manager 360 (CM360) at the same time as >x<, your conversions will be de-duplicated. Make sure you’re comparing conversion data from Floodlight Activities that have a direct match to your >x< conversion events."]}]},{"id":"help-m012429-item-5","q":["How can I get more help?"],"blocks":[{"type":"p","runs":["File a >x< Ads ",{"a":"https://ads.x.com/help","r":["support ticket"]}," or work directly with your Account Manager."]}]},{"id":"help-m012429-item-6","q":["I am running campaigns with a CM360 click tag that is driving to different destination URLs with different ads under one ad group. In CM360, the click tag is trafficked to one destination URL only. How will >x< be able to track data for multiple destination URLs if we only use one-click tag at the ad group level (as opposed to multiple at the creative level)?"],"blocks":[{"type":"p","runs":["We wrap all URLs present inside the destination URL of an ad or its content with a click tag. We ignore the URL provided on CM360-side during tag creation and tell the tags where to redirect dynamically."]},{"type":"p","runs":["For example: Let’s say you have two ads with different URLs inside two different posts under one Ad Group."]},{"type":"p","runs":["URL 1: x.com/helpcenter"]},{"type":"p","runs":["URL 2: x.com/adsmanager"]},{"type":"p","runs":["Click Tag added on Ad Group level: https://ad.doubleclick.net/ddm/trackclk/N7480.3703766XDCMS2S/B22235515.259854822;dc_trk_aid=435778851;dc_trk_cid=111445022;ltd=0?"]},{"type":"p","runs":["Here is how that dynamic tag configuration works (this is all handled automatically by our integration, so this is just a demo):"]},{"type":"p","runs":["Wrapped URL 1:"]},{"type":"p","runs":["https://ad.doubleclick.net/ddm/trackclk/N7480.3703766XDCMS2S/B22235515.259854822;dc_trk_aid=435778851;dc_trk_cid=111445022;ltd=0?",{"b":["https://x.com/helpcenter"]}]},{"type":"p","runs":["Wrapped URL 2:"]},{"type":"p","runs":["https://ad.doubleclick.net/ddm/trackclk/N7480.3703766XDCMS2S/B22235515.259854822[...]_aid=435778851;dc_trk_cid=111445022;ltd=0?",{"b":["https://x.com/adsmanager"]}]}]},{"id":"help-m012429-item-7","q":["Can I utilize the DCM Click Tag on the creative level (ad level) instead of the ad group level?"],"blocks":[{"type":"p","runs":["Placing the DCM Click Tag on the “creative-level” (ad level) of your campaigns alongside the ad group level tag will disrupt attribution tracking and negatively impact performance."]},{"type":"p","runs":["Example of a wrong setup:"]},{"type":"image","w":756,"h":866,"alt":"","maxHeight":640},{"type":"p","runs":[{"i":["*Click Tag is appended on the creative level under the Website URL field."]}]},{"type":"p","runs":["Example of a correct setup:"]},{"type":"image","w":512,"h":1000,"alt":"","maxHeight":820},{"type":"p","runs":["*",{"i":["Click Tag is appended on the ad group level under the measurement tab."]}]}]}]},{"type":"heading","level":3,"runs":["Ready to get started?"],"id":"ready-to-get-started"},{"type":"ctas","items":[{"label":"Create your ad","href":"https://ads.x.com/?ref=en-btc-help-doubleclick-footer","primary":true}]}]}