{
  "name": "ziiz",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ziiz/theme build && pnpm --parallel --filter @ziiz/theme --filter www dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter www start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @ziiz/theme build && pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,mdx,mjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,mdx,mjs,json,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
