{
  "name": "@ziiz/theme",
  "version": "0.1.0",
  "description": "ziiz design layer: ramp tokens, type roles, materials, prose, Shiki, and the shadcn slot bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nafisazizir/ziiz.git",
    "directory": "packages/theme"
  },
  "homepage": "https://ziiz.vercel.app",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./theme.css",
    "./shadcn.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "theme.css",
    "shadcn.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "style": "./theme.css",
      "default": "./theme.css"
    },
    "./theme.css": "./theme.css",
    "./shadcn.css": "./shadcn.css",
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js",
      "default": "./dist/cn.js"
    },
    "./shiki": {
      "types": "./dist/shiki.d.ts",
      "import": "./dist/shiki.js",
      "default": "./dist/shiki.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "shiki": ">=3",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "shiki": "4.4.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
