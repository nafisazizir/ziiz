{
  "name": "@ziiz/theme",
  "version": "0.0.1",
  "description": "ziiz design layer: ramp tokens, type roles, materials, prose, Shiki, and the shadcn slot bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nafisazizir/ziiz.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/nafisazizir/ziiz/tree/main/packages/theme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./theme.css",
    "./shadcn.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "theme.css",
    "shadcn.css",
    "README.md"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./shadcn.css": "./shadcn.css",
    "./shiki": {
      "types": "./dist/shiki.d.ts",
      "import": "./dist/shiki.js",
      "default": "./dist/shiki.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
